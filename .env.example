# Copy to `.env`. Never commit `.env` -- it is gitignored.
#
# THE OLLAMA PATH REQUIRES NO API KEY AT ALL. Every key below is optional; leave
# them blank and the agent runs fully locally.

# ---------------------------------------------------------------------------
#  Provider
# ---------------------------------------------------------------------------
# ollama (default, local, unlimited) | gemini | auto
PROVIDER=ollama

# ---------------------------------------------------------------------------
#  Ollama
# ---------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# 8B-class at Q4_K_M (~5 GB) -- fits alongside both resident encoders.
OLLAMA_MODEL=llama3.1:8b
# 14B-class at Q4_K_M (~9 GB) -- only loadable in OFFLOAD_MODE=sequential.
OLLAMA_MODEL_LARGE=qwen2.5:14b

# ---------------------------------------------------------------------------
#  Gemini (optional)
#
#  Free-tier quota is per project, not per key: three keys from one Google Cloud
#  project share one bucket and rotation buys nothing. Use separate projects if
#  you want the ladder to actually multiply capacity. `budget` reports real
#  per-key consumption from the ledger, so you can check rather than assume.
# ---------------------------------------------------------------------------
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ---------------------------------------------------------------------------
#  Hardware
# ---------------------------------------------------------------------------
# coresident : encoders stay hot on GPU; local LLM must fit the remaining VRAM.
# sequential : free encoders after retrieval, then call a larger local model.
OFFLOAD_MODE=coresident
EMBED_DEVICE=cuda
# Set false ONLY to run the CPU fallback knowingly. `pip install torch` silently
# installs a CPU wheel and runs ~5x slower with no error, so this defaults true.
REQUIRE_CUDA=true

# ---------------------------------------------------------------------------
#  Thresholds
#
#  MEASURED in Step 5 from the rerank score distribution, never guessed and never
#  carried over from another corpus. Until THRESHOLDS_ARE_MEASURED is true the
#  router refuses to run rather than routing everything to ANSWER.
# ---------------------------------------------------------------------------
#  MEASURED 2026-08-20 against corpus e62c6925a03ad297 by
#  `research-agent eval-retrieval`. Evidence, including both score histograms and
#  the sensitivity sweep, is in outputs/eval_report.md.
THRESHOLDS_ARE_MEASURED=true
TAU_LOW=0.736
TAU_HIGH=0.786
TAU_VERIFY=0.378

# ---------------------------------------------------------------------------
#  Ops
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
